{
  "name": "palai-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n backend,frontend npm:dev:server npm:dev:web",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:tester": "node --env-file-if-exists=.env --import tsx dev/backend-tester/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "test": "node --import tsx --test tests/health.test.ts tests/text-chat.test.ts tests/transcribe.test.ts tests/photo.test.ts",
    "smoke:text": "node --env-file-if-exists=.env --import tsx dev/backend-tester/smoke-text.ts",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
